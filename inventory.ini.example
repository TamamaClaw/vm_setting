# このファイルをコピーして inventory.local を作成してください
# cp inventory.ini.example inventory.local
# inventory.local は .gitignore されています (パスワードを含むため)

[vms]
# ローカル実行
localhost ansible_connection=local ansible_user=user ansible_become_password=YOUR_SUDO_PASSWORD

# リモートVM (SSH接続)
# 192.168.1.100 ansible_user=user ansible_port=2232 ansible_become_password=YOUR_SUDO_PASSWORD

[vms:vars]
ansible_python_interpreter=/usr/bin/python3
